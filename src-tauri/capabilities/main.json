{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled VIO window may control its own audio capture.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-desktop-capabilities",
    "allow-desktop-sources",
    "allow-desktop-start-audio",
    "allow-desktop-read-audio",
    "allow-desktop-stop-audio",
    "allow-desktop-compact"
  ]
}
