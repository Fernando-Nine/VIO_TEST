# Node 24. Copie para .env. Não versione .env.
NODE_ENV=development
PORT=3000
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
# Em produção: https://seu-servico.onrender.com,https://vio.seudominio.com
# RENDER_EXTERNAL_URL é acrescentada automaticamente pelo adapter de configuração.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false sem proxy; 1 apenas quando existe um único proxy confiável e sem caminho direto.
TRUST_PROXY=false
SOCKET_PATH=/socket.io
# Vazio usa a origem da página. O mesmo servidor fornece /api/session e /api/config.
SIGNALING_URL=
STUN_URLS=stun:stun.l.google.com:19302
# TURN é opcional, e tem DOIS caminhos possíveis — nunca os dois juntos.
# Veja docs/TURN.md para o passo a passo de cada um.
#
# Caminho 1 — Cloudflare Realtime (gerenciado, sem servidor próprio):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Caminho 2 — coturn auto-hospedado (controle total, exige uma VM sua):
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=600
MAX_PARTICIPANTS=6
MAX_ROOMS=200
MAX_SOCKETS_PER_IP=20
RECONNECT_GRACE_SECONDS=90
ROOM_TTL_SECONDS=300
WEB_CONCURRENCY=1
# Laboratório local somente. Produção rejeita o valor 1.
ENABLE_TEST_LAB=0
