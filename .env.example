# Node 24. Copie para .env. Não versione .env.
NODE_ENV=development
PORT=3000
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
# Em produção: https://seu-servico.onrender.com,https://vio.seudominio.com
# RENDER_EXTERNAL_URL é acrescentada automaticamente pelo adapter de configuração.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false sem proxy; 1 apenas quando existe um único proxy confiável e sem caminho direto.
TRUST_PROXY=false
# Origem de casca nativa (Tauri, invólucro de celular). Lista SEPARADA de
# ALLOWED_ORIGINS de propósito: a exigência de HTTPS lá protege a web e não é
# afrouxada aqui. Só passa esquema próprio ou host local, e sem caminho.
# Ex: tauri://localhost,http://tauri.localhost,capacitor://localhost
# Vazio na web, que é o caso normal.
ALLOWED_APP_ORIGINS=
SOCKET_PATH=/socket.io
# Vazio usa a origem da página. O mesmo servidor fornece /api/session e /api/config.
SIGNALING_URL=
STUN_URLS=stun:stun.l.google.com:19302
# TURN é opcional, e tem TRÊS caminhos possíveis — nunca mais de um ao mesmo tempo.
# Veja docs/TURN.md para o passo a passo e o custo de cada um.
#
# Caminho 1 — credencial estática (mais rápido de ligar; a credencial NÃO expira):
# TURN_URLS=turn:host.do.provedor:3478
# TURN_USERNAME=
# TURN_PASSWORD=
#
# Caminho 2 — Cloudflare Realtime (gerenciado, credencial efêmera via API):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Caminho 3 — coturn auto-hospedado (controle total, exige uma VM sua):
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=600
# Sem teto de participantes por sala. A interface avisa sobre o custo a partir de 6.
MAX_ROOMS=200
MAX_SOCKETS_PER_IP=20
RECONNECT_GRACE_SECONDS=90
ROOM_TTL_SECONDS=300
WEB_CONCURRENCY=1
# Laboratório local somente. Produção rejeita o valor 1.
ENABLE_TEST_LAB=0
